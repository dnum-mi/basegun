{
  "name": "basegun",
  "version": "3.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "start": "API_HOST=http://localhost:5000 vite",
    "lint": "eslint . --fix --ignore-path ../.gitignore",
    "format": "prettier . --write",
